{% macro menuItems(items, columns) %}
  {% if columns %}
    <div class="mb-3 grid gap-2 text-right text-[0.7rem] font-bold uppercase leading-tight tracking-wide text-[#ffd414] {% if columns.length == 3 %}grid-cols-[minmax(0,1fr)_3.5rem_4.5rem_3.5rem]{% else %}grid-cols-[minmax(0,1fr)_4.5rem_4.5rem]{% endif %}">
      <span></span>
      {% for column in columns %}<span>{{ column }}</span>{% endfor %}
    </div>
  {% endif %}
  <ul class="space-y-4">
    {% for item in items %}
      <li class="grid break-inside-avoid gap-x-2 border-b border-zinc-700/80 pb-4 last:border-0 last:pb-0 {% if columns and columns.length == 3 %}grid-cols-[minmax(0,1fr)_3.5rem_4.5rem_3.5rem]{% elif columns %}grid-cols-[minmax(0,1fr)_4.5rem_4.5rem]{% else %}grid-cols-[minmax(0,1fr)_auto]{% endif %}">
        <div class="min-w-0">
          <span class="font-extrabold uppercase leading-snug tracking-wide text-zinc-50">{{ item.name }}</span>
          {% if item.description %}<p class="mt-1 text-sm font-normal leading-snug text-zinc-300">{{ item.description }}</p>{% endif %}
        </div>
        {% for price in item.prices %}<span class="ml-1 w-fit self-start justify-self-end rounded-md bg-[#ffd414] px-1.5 py-1 text-center text-sm font-bold text-black shadow-sm shadow-black/20">{{ price }}</span>{% endfor %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% macro menuCard(section) %}
  <section id="{{ section.title | slugify }}" class="scroll-mt-52 rounded-xl bg-black p-5 shadow-lg shadow-black/30 md:p-6">
    <div class="menu-brush -mx-5 mb-6 bg-[#ffd414] px-8 py-4 md:-mx-6 shadow-md shadow-black/35 md:px-10">
      <h3 class="text-2xl font-bold uppercase tracking-wide text-black md:text-3xl">{{ section.title }}</h3>
      {% if section.note %}<p class="mt-2 inline-flex bg-black px-3 py-1 font-bold uppercase tracking-wide text-amber-300">{{ section.note }}</p>{% endif %}
    </div>
    {{ menuItems(section.items, section.columns) }}
  </section>
{% endmacro %}

<article class="bg-black">
  <header class="relative overflow-hidden border-b border-red-800/50">
    <img src="/assets/images/big-mikes-hero.png" alt="" class="absolute inset-0 h-full w-full object-cover object-[center_45%] opacity-40" loading="eager" eleventy:ignore>
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
    <div class="container relative flex min-h-[30rem] max-w-7xl flex-col justify-center py-16 md:min-h-[38rem] md:py-20 lg:min-h-[44rem]">
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-amber-300">Big Mike's Market &amp; More</p>
      <h1 class="max-w-4xl text-balance text-zinc-50">Menu</h1>
      <p class="mt-5 max-w-2xl text-lg font-medium text-zinc-100 md:text-xl">Breakfast, halal platters, signature sandwiches, cold cuts, omelettes, burgers, and sides.</p>
    </div>
  </header>
  <nav class="sticky top-16 z-40 border-b border-amber-500/40 bg-black/95 shadow-lg shadow-black/30 backdrop-blur-sm md:top-20" aria-label="Menu sections">
    <div class="container flex max-w-7xl gap-3 overflow-x-auto py-3 md:flex-wrap md:justify-center md:overflow-visible">
      {% for menuGroup in menuGroups %}
        {% for section in menuGroup.sections %}
          <a href="#{{ section.title | slugify }}" class="whitespace-nowrap rounded-full border-2 border-amber-500/60 bg-black/80 px-4 py-2 text-sm font-bold uppercase tracking-wide text-amber-300 no-underline transition-colors hover:border-amber-300 hover:bg-black hover:text-amber-200">{{ section.title }}</a>
        {% endfor %}
      {% endfor %}
    </div>
  </nav>
  <div class="container max-w-7xl py-12 md:py-16">
    <div class="space-y-16 md:space-y-20">
      {% for menuGroup in menuGroups %}
        <div>
          <div class="grid items-start gap-6 {% if menuGroup.columns == 2 %}lg:grid-cols-2{% elif menuGroup.columns == 3 %}lg:grid-cols-2 xl:grid-cols-3{% endif %}">
            {% for section in menuGroup.sections %}{{ menuCard(section) }}{% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</article>
